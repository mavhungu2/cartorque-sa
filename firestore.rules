rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profiles: anyone authenticated can read; only the user can write their own profile.
    match /profiles/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // Listings: anyone (signed in or not) can read listings with status == 'live'.
    // Owners can read their own non-live listings. Owners can create/update/delete their own.
    match /listings/{listingId} {
      allow read: if resource.data.status == 'live'
                  || (request.auth != null && request.auth.uid == resource.data.ownerId);
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status in ['draft', 'pending_review'];
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId; // can't change owner
      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
